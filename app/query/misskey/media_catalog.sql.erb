SELECT
  drive_file.id,
  drive_file.name,
  drive_file.type,
  drive_file.size AS file_size,
  drive_file.properties AS meta,
  note_file.note_id AS status_id,
  note_file.text AS status_text,
  note_file.visibility,
  drive_file."isSensitive" AS sensitive,
  note_file.cw AS spoiler_text,
  note_file.username,
  note_file.display_name
FROM
  drive_file
  INNER JOIN (
    SELECT
      note.id as note_id,
      unnest(note."fileIds") as file_id,
      note.visibility,
      note.text,
      note.cw,
      "user".username,
      "user".name AS display_name
    FROM
      note
      INNER JOIN "user" ON note."userId" = "user".id
    WHERE (0 < array_length(note."fileIds", 1))
      AND (note."userHost" IS null)
      <%# 🔴 **公開だけ（5.41.0 のリリース前レビュー）。**以前はホーム公開（unlisted）も含めていた。 -%>
      AND (note."visibility" = '<%= controller_class.visibility_name(:public) %>')
      <% unless params[:only_person].to_i.zero? %>
        AND ("user"."isBot" = false)
      <% end %>
      <% if test_account %>
        AND ("user".id <> '<%= test_account.id %>')
      <% end %>
    ORDER BY
      note.id DESC
  ) AS note_file ON drive_file.id = note_file.file_id
WHERE (drive_file."userHost" IS null)
  <%# RSS はぼかせないので、閲覧注意・CW つきを外す（`safe` は feed だけが渡す）。 -%>
  <% if params[:safe] %>
    AND (drive_file."isSensitive" = false)
    AND (coalesce(note_file.cw, '') = '')
  <% end %>
  <% if params[:rule] %>
    <% params[:rule].keywords.each do |keyword| %>
      AND (concat_ws(E'\t', note_file.text, note_file.cw, drive_file.name) LIKE '%<%= escape(keyword) %>%')
    <% end %>
    <% params[:rule].negative_keywords.each do |keyword| %>
      AND (coalesce(note_file.text, '') NOT LIKE '%<%= escape(keyword) %>%')
      AND (coalesce(note_file.cw, '') NOT LIKE '%<%= escape(keyword) %>%')
      AND (coalesce(drive_file.name, '') NOT LIKE '%<%= escape(keyword) %>%')
    <% end %>
  <% end %>
  <% if params[:cursor] %>
    AND (note_file.note_id < '<%= params[:cursor] %>')
  <% end %>
ORDER BY
  note_file.note_id DESC
LIMIT <%= params[:limit] %>
<% unless params[:cursor] %>
  <%# ページ幅は呼び出し側が計算して渡す。has_next 用の +1 を混ぜない (#4632) -%>
  OFFSET <%= params[:offset].to_i %>
<% end %>
