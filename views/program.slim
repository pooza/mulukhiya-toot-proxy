doctype html
html lang='ja' data-theme='light'
  head
    == slim.render 'fragment/metadata'
    == slim.render 'fragment/assets'
  body
    == slim.render 'fragment/header'
    == slim.render 'fragment/breadcrumbs', {entries: [{label: 'モロヘイヤHOME', href: '/mulukhiya'}, {label: '番組表エディタ'}]}
    main#app v-cloak='' class="program-editor #{env.type}"
      == slim.render 'fragment/message'
      h2 番組表エディタ
      p.alert v-if='!account.is_admin' 管理者のみ利用できます。
      section v-if='account.is_admin'
        p.alert v-if='!editable'
          | 自動更新が有効のため、編集できません。 #[code config/local.yaml] の #[code /program/auto_update] を #[code false] に設定すると編集可能になります。
        .field-update-button-container v-if='editable'
          button @click='openAdd' v-if='!form.open'
            i class='fa fa-plus'
            |  新規追加
        section.config v-if='editable && form.open'
          h3
            | {{form.editKey ? `エントリ編集: ${form.editKey}` : '新規エントリ'}}
          .annict-search
            .field-container
              input type='search' placeholder='作品名検索フレーズ' v-model.trim='annict.keyword' @keydown.enter.prevent='searchAnnictWorks'
              button @click='searchAnnictWorks' 検索
            .indented v-if='annict.works.length'
              h4 作品を選択
              ul.annict-works
                li v-for='work in annict.works' :key='work.annictId'
                  button.option @click='selectAnnictWork(work)'
                    | {{work.title}}
                    | &nbsp;
                    small v-if='work.seasonYear'
                      | {{work.seasonYear}}
            .indented v-if='annict.episodes.length'
              h4 エピソードを選択
              ul.annict-episodes
                li v-for='episode in annict.episodes' :key='episode.annictId'
                  button.option @click='selectAnnictEpisode(episode)'
                    | {{episode.numberText}}
                    small
                      | {{episode.title}}
          .field-container v-if='form.editKey'
            label
              span 識別子
              code.key-readonly
                | {{form.editKey}}
          .field-container v-else=''
            label
              span 識別子
              input type='text' v-model.trim='form.values.key' placeholder='省略可（自動生成）'
          .field-container
            label
              span 作品
              input type='text' v-model.trim='form.values.series'
          .field-container
            label
              span Annict Work ID
              input type='number' v-model.number='form.values.annict_work_id' min='0'
          .field-container
            label
              span 話数
              input type='number' v-model.number='form.values.episode' min='0'
          .field-container
            label
              span 話数表記
              input type='text' v-model.trim='form.values.episode_suffix' placeholder='話'
          .field-container
            label
              span サブタイトル
              input type='text' v-model.trim='form.values.subtitle'
          .field-container
            label
              span Annict Episode ID
              input type='number' v-model.number='form.values.annict_episode_id' min='0'
          .field-container
            label
              span 放送時間
              input type='number' v-model.number='form.values.minutes' min='0' placeholder='30'
          .field-container
            label
              span 開始時刻
              input type='text' v-model.trim='form.values.start_time' pattern='([01]?\d|2[0-3]):[0-5]\d' placeholder='21:00' title='24 時間制 HH:MM（例 21:00）'
          .field-container
            label
              span 次回放送日
              input type='date' v-model='form.values.next_on' title='空欄なら毎日。日付を入れるとその日に1回だけ通知し、過ぎたら止まります'
            small.field-note 空欄＝毎日。ウィークリー枠は日付を入れる（一覧の次回放送日欄にある ＋ ボタンで1日ずつ進みます。翌週にするなら7回）。
          .field-container
            label
              span 説明
              textarea v-model='form.values.description' rows='4' maxlength='1000' placeholder='実況の準備のための注意書きなど'
            small.field-note iCalendar の DESCRIPTION として配信し、tomato-shrieker の通知本文にも載ります。⚠ 購読 URL は無認証で公開されているので、内輪のメモは書かないでください。空欄なら追加タグをハッシュタグとして出します。
          .field-container
            label
              span 追加タグ
              textarea v-model='form.extraTagsText' rows='3' placeholder='改行区切りでタグを列挙（タグ先頭の # は省略）'
          .inline-field-container
            label
              input type='checkbox' v-model='form.values.air'
              |  エア番組
            label
              input type='checkbox' v-model='form.values.livecure'
              |  実況対象
            label
              input type='checkbox' v-model='form.values.enable'
              |  有効
          .field-update-button-container
            button @click='submitForm' 保存
            button.cancel @click='cancelForm' キャンセル
        section
          h3 エントリ一覧
          - if Mulukhiya::Environment.controller_class.livecure?
            - ics_uri = Mulukhiya::ProgramCalendarRenderer.uri
            p.program-ics
              i class='fa fa-calendar'
              | &nbsp;iCalendar 購読 URL:&nbsp;
              a href=ics_uri target='_blank' rel='noreferrer' = ics_uri
              br
              small 有効で開始時刻を設定したエントリを配信します。カレンダーアプリや tomato-shrieker で購読できます。
          .field-update-button-container v-if='Object.keys(entries).length'
            button @click='copySummary' v-tooltip.top="'有効エントリ全体を作品名・話数+サブタイトル形式でクリップボードにコピー'"
              i class='fa fa-copy'
              |  まとめをコピー
          p.alert v-if='!Object.keys(entries).length' エントリがありません。「新規追加」から登録してください。
          table.program-entries v-if='Object.keys(entries).length'
            thead
              tr
                th 次回放送日
                th 開始時刻
                th 作品
                th 話数
                th サブタイトル
                th 放送時間
                th エア番組
                th 実況
                th 有効
                th
            tbody
              tr v-for='({key, entry}) in sortedEntries' :key='key' :class="{disabled: !entry.enable, clickable: editable}" @click='editable && openEdit(key)'
                td
                  template v-if='entry.next_on'
                    small :class="{stale: isStaleNextOn(displayNextOn(key, entry)), invalid: isInvalidNextOn(entry.next_on)}"
                      | {{displayNextOn(key, entry)}}
                    span.tag.stale v-if='isStaleNextOn(displayNextOn(key, entry))' v-tooltip.top="'次回放送日が過ぎています。通知は止まっています'"
                      i class='fa fa-circle-exclamation' aria-hidden='true'
                      span.sr-only 次回放送日が過去
                    span.tag.invalid v-if='isInvalidNextOn(entry.next_on)' v-tooltip.top="'次回放送日が日付として読めません。通知は止まっています'"
                      i class='fa fa-triangle-exclamation' aria-hidden='true'
                      span.sr-only 次回放送日が不正
                    button.small @click.stop='advanceNextOn(key, entry)' v-if='editable && !isInvalidNextOn(entry.next_on)' :disabled='isLocked(key)' v-tooltip.top="'次回放送日を1日進める（連打でまとめて送信）'"
                      i class='fa fa-plus'
                      span.sr-only 次回放送日を1日進める
                  small.muted v-else='' 毎日
                td
                  small v-if='entry.start_time'
                    | {{entry.start_time}}
                td
                  code v-if='entry.annict_work_id'
                    | {{entry.annict_work_id}}
                  span
                    | {{entry.series}}
                  button.small @click.stop='copyText(entry.series, "作品名")' v-if='entry.series' v-tooltip.top="'作品名をコピー'"
                    i class='fa fa-copy'
                td
                  span v-if='entry.episode'
                    | {{entry.episode}}{{entry.episode_suffix || '話'}}
                  button.small @click.stop='incrementEpisode(key)' v-if='editable' :disabled='isBusy(key)' v-tooltip.top="'話数を1つ進める（次回放送日は変わりません）'"
                    i class='fa fa-plus'
                td
                  code v-if='entry.annict_episode_id'
                    | {{entry.annict_episode_id}}
                  span
                    | {{entry.subtitle}}
                  button.small @click.stop='copyEpisodeSubtitle(entry)' v-if='entry.episode || entry.subtitle' v-tooltip.top="'話数+サブタイトルをコピー'"
                    i class='fa fa-copy'
                td
                  small v-if='entry.minutes'
                    | {{entry.minutes}}分
                td
                  span.tag.air v-if='entry.air'
                    i class='fa fa-check' aria-hidden='true'
                    span.sr-only エア番組
                td
                  span.tag.livecure v-if='entry.livecure'
                    i class='fa fa-check' aria-hidden='true'
                    span.sr-only 実況対象
                td
                  button.small.enable-toggle :class="{off: !entry.enable}" @click.stop='toggleEnable(key, entry)' v-if='editable' :disabled='isBusy(key)' :aria-pressed="entry.enable ? 'true' : 'false'" v-tooltip.top="entry.enable ? '無効にする' : '有効にする'"
                    i class='fa' :class="entry.enable ? 'fa-check' : 'fa-xmark'" aria-hidden='true'
                    span.sr-only
                      | {{entry.enable ? '有効' : '無効'}}
                  span.tag.enable v-else-if='entry.enable'
                    i class='fa fa-check' aria-hidden='true'
                    span.sr-only 有効
                td.actions
                  button.small.danger @click.stop='deleteEntry(key)' v-if='editable' :disabled='isBusy(key)' v-tooltip.top="'削除'"
                    i class='fa fa-trash' aria-hidden='true'
                    span.sr-only 削除
    == slim.render 'fragment/footer'
    script type='module'
      |
        import { createApp } from 'vue'
        import { MulukhiyaLib } from 'mulukhiya_lib'
        import { SlideUpDown } from 'slide_toggle'
        import { VTooltip } from 'v_tooltip'
        import Swal from 'sweetalert2'

        // 番組表の標準の並び順まわり (#4540)。一覧と「まとめをコピー」の両方が
        // 使うので、比較はここ 1 箇所に置く。サーバー側の Program.sort_key と
        // 同じ規則 (next_on 昇順 → start_time 昇順、日付なしは末尾)。
        const TIME_FORMAT = /^([01]?\d|2[0-3]):[0-5]\d$/
        const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土']
        // 1 リクエストで進められる日数の上限 (#4585)。サーバー側の
        // Program::NEXT_ON_ADVANCE_MAX_DAYS と揃える。
        const NEXT_ON_ADVANCE_MAX_DAYS = 366

        // 開始時刻を 0 時からの分に直す。HH:MM として読めない値はその日の末尾へ。
        const startMinutes = entry => {
          const value = String(entry.start_time ?? '')
          if (!TIME_FORMAT.test(value)) return Number.POSITIVE_INFINITY
          const [hour, minute] = value.split(':').map(Number)
          return (hour * 60) + minute
        }

        const compareEntries = (a, b) => {
          const dateA = a.next_on ? String(a.next_on) : null
          const dateB = b.next_on ? String(b.next_on) : null
          // 日付を持たない「毎日」枠は次回がいつか決まらないので末尾へ送る。
          if (dateA === null || dateB === null) {
            if (dateA !== dateB) return dateA === null ? 1 : -1
          } else if (dateA !== dateB) {
            return dateA < dateB ? -1 : 1
          }
          // ⚠ 引き算にしない。両方 Infinity だと NaN になり並びが崩れる。
          const minutesA = startMinutes(a)
          const minutesB = startMinutes(b)
          if (minutesA === minutesB) return 0
          return minutesA < minutesB ? -1 : 1
        }

        // YYYY-MM-DD として実在する日付か (#4558)。
        // ⚠ Number.isNaN だけでは足りない。Date.UTC(2026, 1, 31) は 3/3 へ
        // 繰り上がるので NaN にならず、存在しない日付が通ってしまう。
        // ⚠ 端末のタイムゾーンを混ぜてはいけないので UTC で組む。
        const isValidDateValue = value => {
          const text = String(value)
          if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false
          const [year, month, day] = text.split('-').map(Number)
          const date = new Date(Date.UTC(year, month - 1, day))
          return date.getUTCFullYear() === year &&
            date.getUTCMonth() + 1 === month &&
            date.getUTCDate() === day
        }

        // まとめコピーの日付見出し。UTC で組んで UTC で曜日を読むので、端末の
        // タイムゾーンによらず next_on の日付そのものの曜日になる。
        // 日付として読めない値はそのまま出す (見出しごと消さない)。
        //
        // ⚠ **曜日を付けるのは実在する日付のときだけ (#4558)。**一覧では
        // 「不正」バッジを出しているのに、コピーした見出しには
        // `2026-02-31 (火)` と一見もっともらしい曜日が付いていた。
        const formatDateHeading = value => {
          if (!isValidDateValue(value)) return String(value)
          const [year, month, day] = String(value).split('-').map(Number)
          const date = new Date(Date.UTC(year, month - 1, day))
          return `${value} (${WEEKDAYS[date.getUTCDay()]})`
        }

        const app = createApp({
          data () {
            return {
              account: {},
              editable: false,
              entries: {},
              // 送信中のエントリ。番組表の更新は無ロックの read-modify-write なので、
              // 「次回」の二度押しは話数 +2・次回放送日 +14 日になり、その週の
              // 通知が丸ごと消える。往復が終わるまでボタンを止める (#4373)。
              busy: {},
              // 日付 ＋ の連打を畳むための保留日数とタイマー (#4585)。+1 日は
              // 「翌週にしたければ 7 回押す」前提なので連打が常用操作になる。
              // ⚠ 1 クリック 1 リクエストにすると、7 往復ぶん待たされたうえ
              // 書き込みロックも 7 回取ることになる (#4534 の 409 が増える)。
              // 画面は先に進め、サーバーへはまとめて 1 回だけ送る。
              pendingDays: {},
              pendingTimers: {},
              annict: {keyword: null, works: [], episodes: []},
              form: {
                open: false,
                editKey: null,
                extraTagsText: '',
                values: {
                  key: '', series: '', episode: null, episode_suffix: '',
                  minutes: 30, start_time: null, subtitle: '', next_on: null,
                  air: false, livecure: true, enable: true,
                  annict_work_id: null, annict_episode_id: null,
                },
              },
            }
          },
          created () {
            this.methods.getConfig().then(e => {this.account = this.methods.createAccountInfo(e)})
            this.methods.getAbout().then(e => {this.editable = !!e?.config?.features?.program_editable})
            this.loadEntries()
          },
          computed: {
            // 放送順 (next_on → start_time) に並べた一覧 (#4540)。
            // サーバーも同じ順で返すが、ここでも並べる。「次回」ボタンで
            // next_on が 1 週進んだとき、再取得を待たずその場で行が移動する。
            sortedEntries () {
              return Object.entries(this.entries)
                .sort(([keyA, a], [keyB, b]) =>
                  compareEntries(a, b) || (keyA < keyB ? -1 : keyA > keyB ? 1 : 0))
                .map(([key, entry]) => ({key, entry}))
            },
          },
          methods: {
            createEmptyValues () {
              return {
                key: '',
                series: '',
                episode: null,
                episode_suffix: '',
                minutes: 30,
                start_time: null,
                subtitle: '',
                next_on: null,
                description: '',
                air: false,
                livecure: true,
                enable: true,
                annict_work_id: null,
                annict_episode_id: null,
              }
            },
            loadEntries () {
              return this.methods.getPrograms()
                .then(e => {this.entries = e || {}})
                .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
            },
            openAdd () {
              this.form.editKey = null
              this.form.values = this.createEmptyValues()
              this.form.extraTagsText = ''
              this.annict.works = []
              this.annict.episodes = []
              this.annict.keyword = null
              this.form.open = true
            },
            openEdit (key) {
              if (this.isLocked(key)) return
              // ⚠ **保留中の日付 ＋ を先に送り切る** (PR #4588 の Codex P2)。
              // ここで開くと古い next_on をフォームへ写し取り、保存でその日付を
              // 書き戻して、押したはずの ＋ が黙って消える。送信と再読込みを
              // 待ってから、サーバーの値で開き直す。
              if (this.pendingDays[key]) {
                this.flushNextOn(key).then(_ => this.openEdit(key))
                return
              }
              const entry = this.entries[key]
              if (!entry) return
              this.form.editKey = key
              this.form.values = Object.assign(this.createEmptyValues(), entry)
              this.form.values.key = key
              this.form.extraTagsText = (entry.extra_tags || []).join('\n')
              this.annict.works = []
              this.annict.episodes = []
              this.annict.keyword = null
              this.form.open = true
              if (entry.annict_work_id) {
                this.methods.getEpisodes(entry.annict_work_id)
                  .then(episodes => {this.annict.episodes = episodes})
                  .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
              }
            },
            cancelForm () {
              this.form.open = false
            },
            buildPayload () {
              const v = Object.assign({}, this.form.values)
              const extraTags = this.form.extraTagsText
                .split(/\r?\n/).map(s => s.trim()).filter(Boolean)
              v.extra_tags = extraTags.length ? extraTags : null
              if (!v.subtitle) v.subtitle = null
              if (!v.start_time) v.start_time = null
              if (!v.next_on) v.next_on = null
              // 空欄・空白のみは null で送って未設定に戻す（他のフィールドと同じ扱い）。
              v.description = (v.description || '').trim() || null
              if (!v.episode_suffix) v.episode_suffix = null
              if (!Number.isFinite(v.episode)) v.episode = null
              if (!Number.isFinite(v.minutes)) v.minutes = null
              if (!Number.isFinite(v.annict_work_id)) v.annict_work_id = null
              if (!Number.isFinite(v.annict_episode_id)) v.annict_episode_id = null
              return v
            },
            submitForm () {
              const payload = this.buildPayload()
              const promise = this.form.editKey
                ? this.methods.updateProgramEntry(this.form.editKey, payload)
                : this.methods.addProgramEntry(payload)
              promise
                .then(_ => {
                  Swal.fire({title: '保存しました。', toast: true, position: 'top-end', icon: 'success', showConfirmButton: false, timer: 2000})
                  this.form.open = false
                  this.loadEntries()
                })
                .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
            },
            deleteEntry (key) {
              if (this.isBusy(key)) return
              Swal.fire({title: `エントリ '${key}' を削除しますか？`, icon: 'warning', showCancelButton: true, confirmButtonText: '削除', cancelButtonText: 'キャンセル'})
                .then(result => {
                  if (!result.isConfirmed) return
                  this.busy[key] = true
                  this.methods.deleteProgramEntry(key)
                    .then(_ => {
                      Swal.fire({title: '削除しました。', toast: true, position: 'top-end', icon: 'success', showConfirmButton: false, timer: 2000})
                      this.loadEntries()
                    })
                    .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
                    .finally(_ => {delete this.busy[key]})
                })
            },
            // 日付として読めない next_on。サーバーは fail-closed で通知を出さない
            // ので、一覧でも「過去日」ではなく「不正」として区別する。文字列比較
            // だけだと 2026-02-31 を過去日、2026/08/08 を未来日と誤って読む。
            // ⚠ 判定の実体は isValidDateValue に 1 本化してある (#4558)。
            // まとめコピーの見出しと判定がずれると、「一覧では不正なのに
            // コピーにはそれらしい曜日が付く」が再発する。
            isInvalidNextOn (nextOn) {
              if (!nextOn) return false
              return !isValidDateValue(nextOn)
            },
            // 今日 (JST) を YYYY-MM-DD で。⚠ ブラウザのローカル日付では組まない。
            // ProgramCalendar は next_on を +09:00 固定で解釈するので、国外の端末で
            // 日付境界をまたぐと「カレンダーからは消えているのに警告が出ない」が
            // ありうる。⚠ toLocaleDateString('en-CA') は ISO 形式を保証しない。
            // Intl データ次第で M/D/YYYY へ落ちると、下の字句比較が未来日を過去日と
            // 誤読する（2027-01-01 < 8/6/2026）ので、年月日を取り出して自分で組む。
            todayKeyJst () {
              const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: 'Asia/Tokyo',
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
              }).formatToParts(new Date())
              const value = (type, digits) => {
                const part = parts.find(entry => entry.type === type)
                return String(Number(part && part.value)).padStart(digits, '0')
              }
              return `${value('year', 4)}-${value('month', 2)}-${value('day', 2)}`
            },
            // next_on が過去日か。過ぎるとカレンダーに出なくなる (#4373) ので、
            // 一覧で気づけるようにする。日付だけで比較する（当日は過去扱いしない）。
            isStaleNextOn (nextOn) {
              if (!nextOn) return false
              if (this.isInvalidNextOn(nextOn)) return false
              return nextOn < this.todayKeyJst()
            },
            // リクエストが実際に飛んでいる最中か。日付 ＋ の連打はこれで止める
            // （止めてしまうと 1 クリック 1 往復に戻ってしまうため）。
            isLocked (key) {
              return !!this.busy[key]
            },
            // この行への書き込みを止めるべきか。
            //
            // ⚠ **保留中の日付 ＋ も「書き込み中」に数える** (PR #4588 の Codex P2)。
            // 600ms の debounce 窓では busy がまだ立っていないので、素朴に書くと
            // その隙に編集フォームが開けて古い next_on を写し取り、保存で
            // **押したはずの ＋ を黙って書き戻す**。他の行操作も flush と重なって
            // 409 を踏み、溜めたクリックごと捨てられる。
            isBusy (key) {
              return this.isLocked(key) || !!this.pendingDays[key]
            },
            toggleEnable (key, entry) {
              if (this.isBusy(key)) return
              const next = !entry.enable
              this.busy[key] = true
              // 楽観更新。放送前後にまとめて切り替えるので、往復を待たずに
              // 行の見た目 (disabled クラス) が追従するほうが手数が減る (#4484)。
              // 失敗したら loadEntries() でサーバーの値へ巻き戻す。
              entry.enable = next
              this.methods.updateProgramEntry(key, {enable: next})
                .then(_ => {
                  Swal.fire({title: next ? '有効にしました。' : '無効にしました。', toast: true, position: 'top-end', icon: 'success', showConfirmButton: false, timer: 2000})
                  this.loadEntries()
                })
                .catch(e => {
                  entry.enable = !next
                  Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'})
                })
                .finally(_ => {delete this.busy[key]})
            },
            incrementEpisode (key) {
              if (this.isBusy(key)) return
              this.busy[key] = true
              this.methods.incrementProgramEpisode(key)
                .then(_ => {
                  Swal.fire({title: '話数を+1しました。', toast: true, position: 'top-end', icon: 'success', showConfirmButton: false, timer: 2000})
                  this.loadEntries()
                })
                .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
                .finally(_ => {delete this.busy[key]})
            },
            // YYYY-MM-DD を days 日進める。⚠ 端末のタイムゾーンを混ぜない
            // （UTC で組んで UTC で取り出す）。読めない値はそのまま返す。
            addDaysToDateKey (value, days) {
              if (!/^\d{4}-\d{2}-\d{2}$/.test(String(value))) return value
              const [year, month, day] = String(value).split('-').map(Number)
              const date = new Date(Date.UTC(year, month - 1, day + days))
              const pad = (v, digits) => String(v).padStart(digits, '0')
              return `${pad(date.getUTCFullYear(), 4)}-${pad(date.getUTCMonth() + 1, 2)}-${pad(date.getUTCDate(), 2)}`
            },
            // 保留中の連打を織り込んだ next_on (#4585)。表示だけをこれで進め、
            // entry.next_on は触らない。
            //
            // ⚠ **並び替えのキーが next_on なので、実体を進めると連打の途中で行が
            // 動く**（一覧は next_on 昇順・#4540）。2 回目のクリックが別の行に
            // 当たってしまうため、行が動くのはサーバーの応答を取り込んだ 1 回だけに
            // する。
            displayNextOn (key, entry) {
              const days = this.pendingDays[key] || 0
              if (!days) return entry.next_on
              return this.addDaysToDateKey(entry.next_on, days)
            },
            // 次回放送日だけを +1 日 (#4585)。話数は動かさない。
            //
            // 表示はクリックごとに即進め、サーバーへは連打が止まってから
            // まとめて 1 回だけ送る。⚠ 失敗しても loadEntries() でサーバーの値を
            // 取り直すので、表示のズレは残らない。
            advanceNextOn (key, entry) {
              if (this.isLocked(key)) return
              if (!entry.next_on || this.isInvalidNextOn(entry.next_on)) return
              this.pendingDays[key] = (this.pendingDays[key] || 0) + 1
              clearTimeout(this.pendingTimers[key])
              // 上限に達したらその場で送る。⚠ 黙って握り潰すと、押したのに
              // 進まない理由が誰にも分からなくなる。
              if (this.pendingDays[key] >= NEXT_ON_ADVANCE_MAX_DAYS) {
                this.flushNextOn(key)
                return
              }
              this.pendingTimers[key] = setTimeout(_ => this.flushNextOn(key), 600)
            },
            // 溜めた日数をまとめて 1 回で送る。⚠ **Promise を返すこと。**
            // openEdit が「先に送り切ってから開く」ために待つ (PR #4588 の Codex P2)。
            flushNextOn (key) {
              const days = this.pendingDays[key]
              delete this.pendingDays[key]
              clearTimeout(this.pendingTimers[key])
              delete this.pendingTimers[key]
              if (!days) return Promise.resolve()
              this.busy[key] = true
              return this.methods.advanceProgramNextOn(key, days)
                .then(_ => {
                  Swal.fire({title: `次回放送日を+${days}日しました。`, toast: true, position: 'top-end', icon: 'success', showConfirmButton: false, timer: 2000})
                  return this.loadEntries()
                })
                .catch(e => {
                  Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'})
                  return this.loadEntries()
                })
                .finally(_ => {delete this.busy[key]})
            },
            copyText (text, label) {
              navigator.clipboard.writeText(text)
                .then(_ => Swal.fire({title: `${label}をコピーしました。`, toast: true, position: 'top-end', icon: 'success', showConfirmButton: false, timer: 2000}))
                .catch(_ => Swal.fire({text: 'クリップボードにコピーできませんでした。', icon: 'error'}))
            },
            copyEpisodeSubtitle (entry) {
              const parts = []
              if (entry.episode) parts.push(`${entry.episode}${entry.episode_suffix || '話'}`)
              if (entry.subtitle) parts.push(entry.subtitle)
              this.copyText(parts.join(' '), '話数+サブタイトル')
            },
            // 有効エントリを一覧と同じ順でコピーする。全件出し、要らない分は
            // 手で削ってもらう (絞るより汎用性が高い)。日付が変わる位置にだけ
            // 見出しを挟み、どこまでがその日かを貼り付け先だけで判別できるように
            // する (#4540)。
            copySummary () {
              let heading = null
              const blocks = Object.values(this.entries)
                .filter(entry => entry.enable)
                .sort(compareEntries)
                .map(entry => {
                  const lines = []
                  const current = entry.next_on ? formatDateHeading(entry.next_on) : '毎日'
                  if (current !== heading) {
                    heading = current
                    lines.push(current)
                  }
                  let head = entry.series
                  if (entry.start_time) {
                    const [h, m] = entry.start_time.split(':')
                    head = `${String(h).padStart(2, '0')}:${m} ${entry.series}`
                  }
                  lines.push(head)
                  const episodeLine = []
                  if (entry.episode) episodeLine.push(`${entry.episode}${entry.episode_suffix || '話'}`)
                  if (entry.subtitle) episodeLine.push(entry.subtitle)
                  if (episodeLine.length) lines.push(episodeLine.join(' '))
                  return lines.join('\n')
                })
              if (!blocks.length) {
                Swal.fire({text: 'コピー対象のエントリがありません。', icon: 'warning'})
                return
              }
              this.copyText(blocks.join('\n\n'), '番組表まとめ')
            },
            searchAnnictWorks () {
              if (!this.annict.keyword) return
              this.annict.episodes = []
              this.methods.getWorks({q: this.annict.keyword})
                .then(works => {this.annict.works = works})
                .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
            },
            selectAnnictWork (work) {
              this.form.values.series = work.title
              this.form.values.annict_work_id = work.annictId
              this.form.values.source_type = 'annict'
              this.methods.getEpisodes(work.annictId)
                .then(episodes => {this.annict.episodes = episodes})
                .catch(e => Swal.fire({text: this.methods.createErrorMessage(e), icon: 'error'}))
            },
            selectAnnictEpisode (episode) {
              this.form.values.subtitle = episode.title || ''
              this.form.values.annict_episode_id = episode.annictId
              const match = String(episode.numberText || '').match(/(\d+)/)
              if (match) this.form.values.episode = parseInt(match[1], 10)
            },
          },
        })
        app.use(MulukhiyaLib)
        app.component('slide-up-down', SlideUpDown)
        app.directive('tooltip', VTooltip)
        app.mount('#app')
